# ==========================================================================
# Template de variáveis de ambiente — copie para .env.local e preencha.
# O .env.local NUNCA é commitado (ver .gitignore). Peça os valores reais
# para o Pedro — não existem aqui por segurança.
#
# O app roda em 3 modos (AUTH_MODE): supabase (default, produção atual),
# cognito-local (dev espelho da AWS) e cognito (produção AWS).
# ==========================================================================

# --- Banco -----------------------------------------------------------------
# Produção atual (Supabase, Session Pooler IPv4):
DATABASE_URL=postgresql://postgres.<ref>:<senha-do-banco>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# Dev com o clone local (docker compose -f infra/docker-compose.dev.yml up -d):
# DATABASE_URL=postgresql://postgres:dev@localhost:5433/painel
# PG_SSL=off            # só no Postgres local (container sem TLS)
# PG_POOL_MAX=8         # conexões do pool por processo (default 8)

# --- Provedor de identidade --------------------------------------------------
# supabase | cognito | cognito-local | mock (mock = pula login; só dev)
AUTH_MODE=supabase

# --- Supabase (AUTH_MODE=supabase) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# anon key (pública por design — usada no login/REST):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key (ADMIN — NUNCA expor no front):
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Secret:
SUPABASE_JWT_SECRET=

# --- Cognito (AUTH_MODE=cognito | cognito-local) ------------------------------
# cognito-local: os dois IDs são gravados aqui pelo `npm run seed:auth`.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_ENDPOINT=http://localhost:9229   # SÓ no cognito-local; remova na AWS

# --- Storage S3/MinIO ---------------------------------------------------------
# Sem S3_BUCKET definido o app não arquiva uploads (comportamento atual Vercel).
# Dev (MinIO do clone local):
# S3_BUCKET=painel-arquivos
# AWS_ENDPOINT_URL=http://localhost:9000   # SÓ no MinIO; remova na AWS
# S3_FORCE_PATH_STYLE=true                 # MinIO exige
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=dev
# AWS_SECRET_ACCESS_KEY=devsecret

# --- Dev helpers ---------------------------------------------------------------
# DEV_USER_EMAIL=voce@empresa.com          # usado por AUTH_MODE=mock
