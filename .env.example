# ==========================================================================
# Template de variáveis de ambiente — copie para .env e preencha.
# O .env NUNCA é commitado (ver .gitignore). Todos esses valores vivem
# SÓ no servidor (Render) e localmente. Nada disso vai para o browser.
# ==========================================================================

# --- Banco (Supabase Postgres via Session Pooler — IPv4, conexões longas) ---
# Pegue em: Supabase → Project Settings → Database → Connection string → Session pooler
# Formato SQLAlchemy/psycopg usado pelo Reflex (rxconfig.py: db_url):
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha-do-banco>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# --- Supabase (Auth + chaves) ---
SUPABASE_URL=https://<ref>.supabase.co
# anon key (pública por design — usada no login/REST):
SUPABASE_ANON_KEY=
# service role key (ADMIN — criar usuários; NUNCA expor no front):
SUPABASE_SERVICE_ROLE_KEY=
# segredo para validar o JWT no backend (Project Settings → API → JWT Secret):
SUPABASE_JWT_SECRET=

# --- App ---
ADMIN_EMAIL=admin@suaempresa.com
# URL pública do app (Render injeta em produção; em dev pode deixar vazio):
API_URL=
