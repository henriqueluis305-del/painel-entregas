# Caddy — serve o front estático do Reflex e faz proxy do backend numa porta só.
# Usado pelo Dockerfile no deploy (Render). Validar na fase de deploy.

:{$PORT}

encode gzip

# Rotas internas do Reflex vão para o backend (websocket de eventos, upload, ping)
@backend path /_event* /_upload* /ping*
reverse_proxy @backend localhost:8000

# Todo o resto é o front estático compilado
root * /app/.web/_static
try_files {path} {path}/ /404.html
file_server
